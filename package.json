{
  "name": "rewindbug",
  "version": "0.3.0",
  "description": "Rewind the last seconds before a browser error into a ready bug report: steps, replay, console, network, Playwright test. No backend.",
  "license": "MIT",
  "funding": "https://ko-fi.com/bybrave",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/rewindbug.browser.js"
    },
    "./download": {
      "types": "./dist/download.d.ts",
      "import": "./dist/download.js"
    },
    "./download/browser": {
      "types": "./dist/download.d.ts",
      "import": "./dist/download.browser.js"
    },
    "./playwright": {
      "import": {
        "types": "./dist/playwright.d.ts",
        "default": "./dist/playwright.js"
      },
      "require": {
        "types": "./dist/playwright.d.cts",
        "default": "./dist/playwright.cjs"
      }
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bybraveHQ/rewindbug.git"
  },
  "homepage": "https://github.com/bybraveHQ/rewindbug#readme",
  "bugs": "https://github.com/bybraveHQ/rewindbug/issues",
  "keywords": [
    "bug-report",
    "session-replay",
    "rrweb",
    "error-tracking",
    "playwright",
    "reproduce"
  ],
  "scripts": {
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsup --watch",
    "build": "tsup && size-limit && pnpm --filter rewindbug-mcp build",
    "size": "size-limit",
    "typecheck": "tsc --noEmit && tsc -p demo/tsconfig.sw.json && tsc -p packages/mcp",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsup && pnpm demo:build && playwright test",
    "test:endpoint": "node --test examples/endpoint/server.test.mjs",
    "demo": "pnpm demo:build && node demo/serve.ts",
    "demo:build": "tsup --config demo/tsup.config.ts",
    "bench": "pnpm build && tsup --config bench/tsup.config.ts && node bench/run.ts"
  },
  "packageManager": "pnpm@11.22.0",
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rrweb/replay": "2.1.7",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "size-limit": "^14.2.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@rrweb/record": "2.1.7"
  }
}
