{
  "name": "rewindbug-mcp",
  "version": "0.4.0",
  "description": "MCP server for rewindbug: receives bug reports on localhost and hands the last bug to your coding agent.",
  "license": "MIT",
  "funding": "https://ko-fi.com/bybrave",
  "type": "module",
  "bin": {
    "rewindbug-mcp": "./dist/cli.js"
  },
  "exports": {
    "./screenshot": "./dist/screenshot.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bybraveHQ/rewindbug.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/bybraveHQ/rewindbug/tree/main/packages/mcp#readme",
  "bugs": "https://github.com/bybraveHQ/rewindbug/issues",
  "keywords": [
    "mcp",
    "bug-report",
    "claude-code",
    "cursor",
    "rewindbug",
    "playwright"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "tsup && vitest run",
    "build": "tsup",
    "schema": "node scripts/schema.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
